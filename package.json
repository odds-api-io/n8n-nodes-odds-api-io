{
	"name": "n8n-nodes-odds-api-io",
	"version": "0.1.0",
	"description": "n8n community node for Odds-API.io: sports odds from 500+ bookmakers across 37 sports. Events, pre-match and live odds, closing lines, value bets, dropping odds and arbitrage.",
	"license": "MIT",
	"homepage": "https://github.com/odds-api-io/n8n-nodes-odds-api-io#readme",
	"keywords": [
		"n8n-community-node-package",
		"odds api",
		"sports odds",
		"betting odds",
		"sports betting",
		"live odds",
		"closing lines",
		"value bets",
		"dropping odds",
		"arbitrage",
		"bookmakers"
	],
	"author": {
		"name": "odds-api-io",
		"email": "hello@odds-api.io",
		"url": "https://odds-api.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/odds-api-io/n8n-nodes-odds-api-io.git"
	},
	"bugs": {
		"url": "https://github.com/odds-api-io/n8n-nodes-odds-api-io/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test \"test/**/*.test.js\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OddsApiIoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/OddsApiIo/OddsApiIo.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.58.7",
		"eslint": "10.15.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
